# ============================================
# Root reference of every environment variable
# used across server/ and client/. Copy the
# relevant parts into server/.env and client/.env
# ============================================

# --- Server (server/.env) ---
PORT=5000
MONGODB_URI=
JWT_SECRET=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_PROVIDER=openai
CLIENT_URL=http://localhost:5173

# --- Client (client/.env) ---
VITE_API_URL=http://localhost:5000/api
